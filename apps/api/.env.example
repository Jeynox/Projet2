# Copier en .env pour le dev local (npm run dev)
DATABASE_URL=postgres://strasbouq:strasbouq@localhost:5432/strasbouq
JWT_SECRET=dev-secret-a-changer
# Clé partagée avec le front (même valeur dans apps/web/.env). Vide en dev = API ouverte en local,
# pratique pour l'explorateur GraphQL ; obligatoire en production.
INTERNAL_API_KEY=
# Compte admin créé au premier démarrage, si aucun admin n'existe (mot de passe : 12 caractères min.)
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=change-moi-maintenant
# Insère le catalogue de démo (produits, commande, message) si les tables sont vides
SEED_DEMO=true
