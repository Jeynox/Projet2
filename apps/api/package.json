{
	"name": "api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"test": "vitest --run",
		"migration:run": "npm run build && typeorm migration:run -d dist/data-source.js",
		"migration:revert": "npm run build && typeorm migration:revert -d dist/data-source.js"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"bcryptjs": "^3.0.3",
		"express": "^5.3.0",
		"graphql": "^16.14.2",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.5.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"sharp": "^0.35.5",
		"typeorm": "^1.1.2"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^24.19.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.17"
	}
}
