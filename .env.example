# Copier en .env à la racine pour docker compose (le .env n'est jamais commité).
# Générer chaque secret avec : openssl rand -hex 32
#   (ou : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# Mot de passe PostgreSQL (caractères URL-safe : lettres, chiffres, - et _)
POSTGRES_PASSWORD=
# Secret de signature des sessions admin (32 caractères minimum)
JWT_SECRET=
# Clé partagée front ↔ API : sans elle, l'API refuse tout (32 caractères minimum)
INTERNAL_API_KEY=

# Compte admin créé au premier démarrage (mot de passe : 12 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Remplissage d'une base vide : true = catalogue (9 produits avec photos) + commande et message
# d'exemple ; catalogue = produits seulement (production) ; false = rien
SEED_DEMO=true

# Port local du site et origine publique (protection CSRF des formulaires).
# En production derrière HTTPS : ORIGIN et SITE_URL = https://votre-domaine.fr
WEB_PORT=3000
ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
